{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read",
      "LS",
      "Glob",
      "Grep",
      "Edit(REPOSITORY_KNOWLEDGE.md)",
      "Edit(docs/onboarding/**)",
      "MultiEdit(REPOSITORY_KNOWLEDGE.md)",
      "MultiEdit(docs/onboarding/**)",
      "Write(REPOSITORY_KNOWLEDGE.md)",
      "Write(docs/onboarding/**)",
      "Bash(git status *)",
      "Bash(git rev-parse *)",
      "Bash(git branch --show-current)",
      "Bash(git switch -c project-onboarding/update-*)",
      "Bash(git diff *)",
      "Bash(Get-Date -Format *)",
      "WebFetch"
    ],
    "deny": [
      "Read(../**)",
      "Edit(../**)",
      "MultiEdit(../**)",
      "Write(../**)",
      "NotebookEdit(../**)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./secrets/**)",
      "Read(./.git/**)",
      "Bash(git -C *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git merge *)",
      "Bash(git rebase *)",
      "Bash(git reset *)",
      "Bash(git clean *)",
      "Bash(cd *)",
      "Bash(pwsh *)",
      "Bash(powershell *)",
      "Bash(sh *)",
      "Bash(bash *)",
      "Bash(cmd *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(node *)",
      "Bash(python *)",
      "Bash(python3 *)",
      "Bash(dotnet *)",
      "Bash(docker *)",
      "Bash(ssh *)",
      "Bash(scp *)",
      "Bash(if *)",
      "Bash(mkdir *)",
      "Bash(Where-Object *)",
      "Bash(Select-Object *)",
      "Bash(ForEach-Object *)",
      "Bash(head *)",
      "Bash(rm *)",
      "Bash(del *)",
      "Bash(Remove-Item *)",
      "Bash(Set-Content *)",
      "Bash(Out-File *)",
      "Bash(New-Item *)",
      "Bash(Copy-Item *)",
      "Bash(Move-Item *)",
      "Bash(rg *)",
      "Bash(Get-ChildItem *)",
      "Bash(Get-Content *)",
      "WebSearch"
    ]
  }
}
